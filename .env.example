# whatsrust environment configuration
# Copy this file to .env and adjust values for your deployment.
# Real .env is gitignored. This file is committed as documentation.
#
# Env vars take precedence over .env values (dotenvy fills unset vars only).
# To load a custom path instead of .env: set WHATSRUST_ENV_FILE=/path/to/file
#
# See docs/adr/0023-env-var-config-dotenvy.md for the configuration policy.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

# TCP port for the REST API / SSE server (default: 7270; fallback: HEALTH_PORT).
# WHATSRUST_PORT=7270

# Bind address for the API server (default: 127.0.0.1 — loopback only).
# WHATSRUST_BIND=127.0.0.1

# Set to 1 to allow non-loopback API binds (e.g. 0.0.0.0).
# Requires WHATSRUST_API_TOKEN when set, or the daemon refuses to start (F3 Phase 0b).
# WHATSRUST_ALLOW_REMOTE=1

# Bearer token required for all API requests when WHATSRUST_ALLOW_REMOTE=1,
# or when WHATSRUST_ALLOWED_HOSTS or WHATSRUST_ALLOWED_ORIGINS is non-empty,
# or when you want to protect the local API. Leave unset for no auth (loopback-only,
# no allowlists). Missing token when required stops the daemon at startup with the fix.
# WHATSRUST_API_TOKEN=your-secret-token-here

# Comma-separated Origin values to accept on cross-site requests (default: empty,
# meaning any request that carries an Origin header is rejected with 403). Only
# needed if a browser-based tool on another origin must call this API directly;
# whatsrust's own CLI/MCP clients never send Origin, so they're unaffected either way.
# Requires WHATSRUST_API_TOKEN, or the daemon refuses to start (amended 2026-10-18, ADR 0044).
# WHATSRUST_ALLOWED_ORIGINS=https://my-trusted-ui.example

# Comma-separated Host values (port optional) to accept in addition to the default
# loopback names (127.0.0.1, localhost, ::1), checked on every request — e.g. the public
# hostname a reverse proxy forwards in its Host header, or another loopback address such
# as 127.0.0.2 (default: empty). Defeats DNS rebinding.
# Requires WHATSRUST_API_TOKEN, or the daemon refuses to start (amended 2026-10-18, ADR 0044).
# WHATSRUST_ALLOWED_HOSTS=my-proxy.example

# Legacy port fallback (superceded by WHATSRUST_PORT).
# HEALTH_PORT=7270

# ---------------------------------------------------------------------------
# MCP listener over HTTP (opt-in, off by default)
# ---------------------------------------------------------------------------

# TCP port for the MCP HTTP listener (default: unset/0 = off; suggested: 7271).
# WHATSRUST_MCP_PORT=7271

# Bearer token for MCP requests; required when WHATSRUST_MCP_PORT is set;
# at least 22 characters; must differ from WHATSRUST_API_TOKEN; generate with
# `openssl rand -base64 32`. Missing or short token stops the daemon at startup.
# WHATSRUST_MCP_TOKEN=<your-token>

# Bind address for the MCP listener (default: 127.0.0.1 — loopback only).
# WHATSRUST_MCP_BIND=127.0.0.1

# Set to 1 to allow non-loopback MCP binds (e.g. 0.0.0.0). The token and all
# message content travel in cleartext unless a TLS-terminating proxy is in front.
# WHATSRUST_MCP_ALLOW_REMOTE=1

# Set to 1 to expose only the 6 read tools; write tools are refused with -32600.
# WHATSRUST_MCP_READ_ONLY=1

# ---------------------------------------------------------------------------
# WhatsApp identity / allowlist
# ---------------------------------------------------------------------------

# Comma-separated phone numbers (digits only) to allow inbound messages from.
# Empty = allow all senders.
# WHATSAPP_ALLOWED=15551234567,447911123456

# Phone number to use for pair-code linking (digits only). Unset = QR code.
# WHATSAPP_PAIR_PHONE=15551234567

# Device name shown in WhatsApp's "Linked Devices" list (default: whatsrust).
# Only used while PAIRING A NEW DEVICE: WhatsApp reads the name once, at pairing time,
# and it's then stored with the session (the `device_name` metadata key) — this var is
# ignored for an already-paired session, and whitespace-only values are treated as unset.
# To rename, unlink the device in WhatsApp -> Linked Devices, set this to the new name,
# and restart to re-pair (scan a new QR code / pair code).
# WHATSRUST_DEVICE_NAME=whatsrust

# ---------------------------------------------------------------------------
# Rate limiter
# ---------------------------------------------------------------------------

# Maximum outbound message burst before per-message pacing kicks in (default: 5).
# WHATSRUST_SEND_BURST=5

# ---------------------------------------------------------------------------
# History sync
# ---------------------------------------------------------------------------

# Set to 1 to skip history sync on connect. Leaner initial pairing, but 1:1 DMs
# will fail with 463 MissingTcToken. Default: off (history sync enabled). ADR 0037.
# WHATSRUST_SKIP_HISTORY_SYNC=0

# Store the messages of the history package the phone sends when the device is
# linked, so those chats already have an anchor for fetch-history (without one the
# phone ignores the request). Default: true. Set to false to ignore the package
# as before. Only a fresh pairing delivers it, so an already-paired profile gets
# nothing from it until it is re-paired. A late answer to a fetch is stored either
# way. ADR 0048.
# WHATSRUST_STORE_PAIRING_HISTORY=true

# ---------------------------------------------------------------------------
# Database backup
# ---------------------------------------------------------------------------

# Directory for automatic SQLite backups. Default: whatsapp.db.backups/
# BACKUP_DIR=whatsapp.db.backups

# ---------------------------------------------------------------------------
# .env file path (bootstrap only)
# ---------------------------------------------------------------------------

# Path to the .env file loaded at startup. Default: ./.env (absent = silent no-op).
# Set this in the real environment (not in .env itself) to point to a custom path.
# WHATSRUST_ENV_FILE=/etc/whatsrust/production.env

# ---------------------------------------------------------------------------
# Backfill knobs (Wave C / ADR 0021-0023)
# Three of these are ban-critical and validated at startup (ADR 0022).
# ---------------------------------------------------------------------------

# Base delay between backfill batch requests in seconds (default: 4).
# GUARDED: floor = 3 s. Polling faster risks WhatsApp rate-limiting or account ban.
# Override (dangerous): set WHATSRUST_DANGEROUSLY_ALLOW_FAST_BACKFILL=1
# WHATSRUST_BACKFILL_INTERVAL_SECS=4

# Maximum concurrent backfill workers (default: 1).
# GUARDED: ceiling = 3. More workers amplify ban risk.
# Override (dangerous): set WHATSRUST_DANGEROUSLY_ALLOW_HIGH_CONCURRENCY=1
# WHATSRUST_BACKFILL_MAX_CONCURRENT=1

# Maximum messages per backfill request (daemon-side clamp, default: 50000).
# GUARDED: ceiling = 50000. Larger single fetches attract server-side scrutiny.
# Override (dangerous): set WHATSRUST_DANGEROUSLY_ALLOW_HUGE_FETCH=1
# WHATSRUST_BACKFILL_MAX_MESSAGES=50000

# Messages per WA fetch request inside one backfill job (default: 50).
# WHATSRUST_BACKFILL_BATCH_SIZE=50

# Maximum total messages to fetch per backfill job before stopping (default: 20000).
# WHATSRUST_BACKFILL_BACKSTOP=20000

# Jitter fraction applied to the batch delay (0.0–1.0, default: 0.4).
# A 40% jitter on a 4 s delay gives [2.4 s, 5.6 s] per batch.
# WHATSRUST_BACKFILL_JITTER_FRAC=0.4

# Per-chat cooldown between backfill jobs in seconds (default: 300 = 5 min).
# WHATSRUST_BACKFILL_COOLDOWN_SECS=300

# Maximum number of backfill jobs in the queue (queued + running + paused, default: 5).
# Excess enqueue attempts return a QueueFull back-pressure response (ADR 0021).
# WHATSRUST_BACKFILL_QUEUE_DEPTH=5

# ---------------------------------------------------------------------------
# Semantic search / embeddings (M2, unguarded/benign ADR 0022)
# ---------------------------------------------------------------------------

# Path to the embedder sidecar command. Unset = semantic search disabled (pure FTS5/BM25).
# Model rollout (ADR 0039): BAAI/bge-m3 (1024-dim, stronger multilingual/cross-language recall)
# is the default for `make run-semantic`. paraphrase-multilingual-MiniLM-L12-v2 (384-dim, lighter,
# faster) stays selectable. Switching models is free/lossless (ADR 0017) — both are multilingual
# for CJK/Thai coverage where unicode61 FTS5 tokenization degrades.
# NOTE: use PREFIX-FREE models only. The e5 family needs asymmetric "query:"/"passage:" prefixes
# that the current symmetric embed() protocol can't express (ADR 0024/0039) — avoid for now.
# Recommended: use the native Rust sidecar (embedder-rs/target/release/whatsrust-embedder, built
# with `make embedder-build`; Python-free per ADR 0040). For fallback/parity checks, the legacy
# Python sidecar (scripts/embedder-sidecar.py) remains available.
# WHATSRUST_EMBEDDER_CMD=/absolute/path/to/whatsrust/embedder-rs/target/release/whatsrust-embedder

# Arguments for the embedder command (optional, space-separated). The Rust sidecar reads
# --model to pick the model (default: bge-m3 via `make run-semantic`; the sidecar's own
# built-in default if run standalone is minilm). See docs/HOWTO.md #5b "Choosing a model".
# Note: the Rust sidecar also reads WHATSRUST_EMBEDDER_MODEL (minilm | bge-m3), which the
# daemon passes on to the child process, as an alternative to --model in WHATSRUST_EMBEDDER_ARGS.
# WHATSRUST_EMBEDDER_ARGS=--model bge-m3
# WHATSRUST_EMBEDDER_ARGS=--model minilm

# Maximum texts per embedder batch (default: 64).
# WHATSRUST_EMBEDDER_BATCH_SIZE=64

# Exponential backoff cap in seconds for sidecar failures (default: 60).
# WHATSRUST_EMBEDDER_BACKOFF_CAP_SECS=60

# Continuous loading-state timeout in seconds (default: 60).
# WHATSRUST_EMBEDDER_LOADING_TIMEOUT_SECS=60

# Periodic drain interval in seconds (default: 60).
# WHATSRUST_EMBEDDER_DRAIN_INTERVAL_SECS=60

# Consecutive transport/loading failures before dropping to Notify-only mode (default: 10).
# WHATSRUST_EMBEDDER_FAILURE_THRESHOLD=10

# Minimum cosine similarity floor for vector-only candidates (default: 0.55, ADR 0041).
# Vector-only hits below this threshold are discarded. Lexical hits are always kept.
# 0.55 is calibrated for bge-m3 (the default model); it's conservative for MiniLM (whose
# vector-only matches score low enough to be effectively filtered out at this floor — lower
# it, e.g. toward 0.35, if using MiniLM). The floor is model-specific: re-measure with
# `make calibrate EMBED_MODEL=<model>` whenever you switch models.
# WHATSRUST_SEMANTIC_MIN_SCORE=0.55

# Maximum vectors to scan per query before skipping vector recall (default: 50000, ADR 0041).
# Prevents unbounded O(n) cost; queries exceeding this cap fall back to lexical-only recall.
# WHATSRUST_SEMANTIC_SCAN_CAP=50000

# Overall budget in seconds for search's query-embed path: covers both waiting for the
# sidecar to finish loading and waiting for the embed reply (default: 20, ADR 0042). Keep
# this below the CLI/MCP clients' 30s timeout (api.rs::cli_get, mcp.rs::http_get/http_post),
# or those callers will give up before search itself falls back — a value >= 30 logs a
# startup warning.
# WHATSRUST_SEMANTIC_QUERY_TIMEOUT_SECS=20

# ---------------------------------------------------------------------------
# Dangerous override flags — only set these if you know what you are doing.
# Each triggers a persistent WARN at startup and in logs.
# ---------------------------------------------------------------------------

# Allow backfill interval below the 3 s safety floor.
# WHATSRUST_DANGEROUSLY_ALLOW_FAST_BACKFILL=1

# Allow more than 3 concurrent backfill workers.
# WHATSRUST_DANGEROUSLY_ALLOW_HIGH_CONCURRENCY=1

# Allow backfill_max_messages above 50000.
# WHATSRUST_DANGEROUSLY_ALLOW_HUGE_FETCH=1
