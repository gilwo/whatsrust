# whatsrust environment configuration
# Copy this file to .env and adjust values for your deployment.
# Real .env is gitignored. This file is committed as documentation.
#
# Env vars take precedence over .env values (dotenvy fills unset vars only).
# To load a custom path instead of .env: set WHATSRUST_ENV_FILE=/path/to/file
#
# See docs/adr/0023-env-var-config-dotenvy.md for the configuration policy.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

# TCP port for the REST API / SSE server (default: 7270; fallback: HEALTH_PORT).
# WHATSRUST_PORT=7270

# Bind address for the API server (default: 127.0.0.1 — loopback only).
# WHATSRUST_BIND=127.0.0.1

# Set to 1 to allow non-loopback API binds (e.g. 0.0.0.0).
# Requires WHATSRUST_API_TOKEN when set.
# WHATSRUST_ALLOW_REMOTE=1

# Bearer token required for all API requests when WHATSRUST_ALLOW_REMOTE=1
# or when you want to protect the local API. Leave unset for no auth.
# WHATSRUST_API_TOKEN=your-secret-token-here

# Legacy port fallback (superceded by WHATSRUST_PORT).
# HEALTH_PORT=7270

# ---------------------------------------------------------------------------
# WhatsApp identity / allowlist
# ---------------------------------------------------------------------------

# Comma-separated phone numbers (digits only) to allow inbound messages from.
# Empty = allow all senders.
# WHATSAPP_ALLOWED=15551234567,447911123456

# Phone number to use for pair-code linking (digits only). Unset = QR code.
# WHATSAPP_PAIR_PHONE=15551234567

# ---------------------------------------------------------------------------
# Rate limiter
# ---------------------------------------------------------------------------

# Maximum outbound message burst before per-message pacing kicks in (default: 5).
# WHATSRUST_SEND_BURST=5

# ---------------------------------------------------------------------------
# History sync
# ---------------------------------------------------------------------------

# Set to 1 to skip history sync on connect. Leaner initial pairing, but 1:1 DMs
# will fail with 463 MissingTcToken. Default: off (history sync enabled). ADR 0037.
# WHATSRUST_SKIP_HISTORY_SYNC=0

# ---------------------------------------------------------------------------
# Database backup
# ---------------------------------------------------------------------------

# Directory for automatic SQLite backups. Default: whatsapp.db.backups/
# BACKUP_DIR=whatsapp.db.backups

# ---------------------------------------------------------------------------
# .env file path (bootstrap only)
# ---------------------------------------------------------------------------

# Path to the .env file loaded at startup. Default: ./.env (absent = silent no-op).
# Set this in the real environment (not in .env itself) to point to a custom path.
# WHATSRUST_ENV_FILE=/etc/whatsrust/production.env

# ---------------------------------------------------------------------------
# Backfill knobs (Wave C / ADR 0021-0023)
# Three of these are ban-critical and validated at startup (ADR 0022).
# ---------------------------------------------------------------------------

# Base delay between backfill batch requests in seconds (default: 4).
# GUARDED: floor = 3 s. Polling faster risks WhatsApp rate-limiting or account ban.
# Override (dangerous): set WHATSRUST_DANGEROUSLY_ALLOW_FAST_BACKFILL=1
# WHATSRUST_BACKFILL_INTERVAL_SECS=4

# Maximum concurrent backfill workers (default: 1).
# GUARDED: ceiling = 3. More workers amplify ban risk.
# Override (dangerous): set WHATSRUST_DANGEROUSLY_ALLOW_HIGH_CONCURRENCY=1
# WHATSRUST_BACKFILL_MAX_CONCURRENT=1

# Maximum messages per backfill request (daemon-side clamp, default: 50000).
# GUARDED: ceiling = 50000. Larger single fetches attract server-side scrutiny.
# Override (dangerous): set WHATSRUST_DANGEROUSLY_ALLOW_HUGE_FETCH=1
# WHATSRUST_BACKFILL_MAX_MESSAGES=50000

# Messages per WA fetch request inside one backfill job (default: 50).
# WHATSRUST_BACKFILL_BATCH_SIZE=50

# Maximum total messages to fetch per backfill job before stopping (default: 20000).
# WHATSRUST_BACKFILL_BACKSTOP=20000

# Jitter fraction applied to the batch delay (0.0–1.0, default: 0.4).
# A 40% jitter on a 4 s delay gives [2.4 s, 5.6 s] per batch.
# WHATSRUST_BACKFILL_JITTER_FRAC=0.4

# Per-chat cooldown between backfill jobs in seconds (default: 300 = 5 min).
# WHATSRUST_BACKFILL_COOLDOWN_SECS=300

# Maximum number of backfill jobs in the queue (queued + running + paused, default: 5).
# Excess enqueue attempts return a QueueFull back-pressure response (ADR 0021).
# WHATSRUST_BACKFILL_QUEUE_DEPTH=5

# ---------------------------------------------------------------------------
# Semantic search / embeddings (M2, unguarded/benign ADR 0022)
# ---------------------------------------------------------------------------

# Path to the embedder sidecar command. Unset = semantic search disabled (pure FTS5/BM25).
# Model rollout (ADR 0039): start with paraphrase-multilingual-MiniLM-L12-v2 (384-dim, light,
# multilingual incl. Hebrew/Arabic) as an MVP, then upgrade to BAAI/bge-m3 (1024-dim, stronger)
# once value is confirmed — switching models is free/lossless (ADR 0017). Both are multilingual
# for CJK/Thai coverage where unicode61 FTS5 tokenization degrades.
# NOTE: use PREFIX-FREE models only. The e5 family needs asymmetric "query:"/"passage:" prefixes
# that the current symmetric embed() protocol can't express (ADR 0024/0039) — avoid for now.
# The MVP sidecar build spec: docs/plans/2026-08-30-embedder-sidecar-mvp.md
# WHATSRUST_EMBEDDER_CMD=/path/to/your-embedder-sidecar

# Arguments for the embedder command (optional, space-separated).
# WHATSRUST_EMBEDDER_ARGS=--model paraphrase-multilingual-MiniLM-L12-v2

# Maximum texts per embedder batch (default: 64).
# WHATSRUST_EMBEDDER_BATCH_SIZE=64

# Exponential backoff cap in seconds for sidecar failures (default: 60).
# WHATSRUST_EMBEDDER_BACKOFF_CAP_SECS=60

# Continuous loading-state timeout in seconds (default: 60).
# WHATSRUST_EMBEDDER_LOADING_TIMEOUT_SECS=60

# Periodic drain interval in seconds (default: 60).
# WHATSRUST_EMBEDDER_DRAIN_INTERVAL_SECS=60

# Consecutive transport/loading failures before dropping to Notify-only mode (default: 10).
# WHATSRUST_EMBEDDER_FAILURE_THRESHOLD=10

# ---------------------------------------------------------------------------
# Dangerous override flags — only set these if you know what you are doing.
# Each triggers a persistent WARN at startup and in logs.
# ---------------------------------------------------------------------------

# Allow backfill interval below the 3 s safety floor.
# WHATSRUST_DANGEROUSLY_ALLOW_FAST_BACKFILL=1

# Allow more than 3 concurrent backfill workers.
# WHATSRUST_DANGEROUSLY_ALLOW_HIGH_CONCURRENCY=1

# Allow backfill_max_messages above 50000.
# WHATSRUST_DANGEROUSLY_ALLOW_HUGE_FETCH=1
